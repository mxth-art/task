# Public browser access (safe to expose in the client)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server/admin access only; keep private and do not expose in the browser
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Vercel deployment placeholders (fill in later when you have the keys)
VERCEL_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
